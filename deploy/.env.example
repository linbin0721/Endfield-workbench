# Copy to deploy/.env (ignored by Git). Replace the values below.
# A public DNS record for API_DOMAIN and reachable TCP ports 80/443 are required for HTTPS.
API_DOMAIN=
CORS_ORIGINS=

# PostgreSQL for the question-number catalog. The db service is only reachable
# on the Compose network and publishes no host port; these credentials are
# passed to the api and db services from this ignored file only.
CATALOG_DB_NAME=endfield_catalog
CATALOG_DB_USER=endfield_catalog
CATALOG_DB_PASSWORD=
