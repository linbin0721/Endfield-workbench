# Copy these into your shell environment before starting the API.
CORS_ORIGINS=http://localhost:5173
MAX_WORKERS=2
MAX_QUEUED=8
RESULT_TTL_SECONDS=900
MAX_RETAINED=100
SOLVE_TIME_LIMIT_SECONDS=3
SOLVE_MAX_NODES=300000
RECOGNIZE_TIME_LIMIT_SECONDS=25
MAX_UPLOADS=2

# Optional question-number catalog. Leave all four values empty to run without
# a catalog: recognition and solving keep working, and catalog endpoints answer
# 503 CATALOG_UNAVAILABLE. Credentials belong in the ignored deploy/.env only.
CATALOG_DB_HOST=
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=endfield_catalog
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=
CATALOG_DB_TIMEOUT_SECONDS=3
