  "components": {
    "schemas": {
      "BalloonPuzzle": {
        "properties": {
          "rule_version": {
            "type": "string",
            "const": "center-torque-v1",
            "title": "Rule Version"
          },
          "rows": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 2.0,
            "title": "Rows"
          },
          "columns": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 2.0,
            "title": "Columns"
          },
          "usable_cells": {
            "items": {
              "$ref": "#/components/schemas/Cell"
            },
            "type": "array",
            "maxItems": 36,
            "minItems": 1,
            "title": "Usable Cells"
          },
          "inventory": {
            "items": {
              "$ref": "#/components/schemas/Stock"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Inventory"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rule_version",
          "rows",
          "columns",
          "usable_cells",
          "inventory"
        ],
        "title": "BalloonPuzzle"
      },
      "BalloonRecognitionResult": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "draft",
              "no_board",
              "timeout",
              "invalid_image",
              "failed"
            ],
            "title": "Outcome"
          },
          "rows": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rows"
          },
          "columns": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Columns"
          },
          "cells": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "usable",
                        "blocked"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cells"
          },
          "inventory": {
            "items": {
              "$ref": "#/components/schemas/InventoryDraft"
            },
            "type": "array",
            "title": "Inventory"
          },
          "target_total_lift": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Total Lift"
          },
          "question_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Code"
          },
          "question_code_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Code Confidence"
          },
          "catalog": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CatalogMatch"
              },
              {
                "type": "null"
              }
            ]
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues"
          }
        },
        "type": "object",
        "required": [
          "outcome"
        ],
        "title": "BalloonRecognitionResult"
      },
      "BalloonRecognitionTaskView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "cancellation_requested": {
            "type": "boolean",
            "title": "Cancellation Requested",
            "default": false
          },
          "computation_stopped": {
            "type": "boolean",
            "title": "Computation Stopped",
            "default": false
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BalloonRecognitionResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at"
        ],
        "title": "BalloonRecognitionTaskView"
      },
      "BalloonSolution": {
        "properties": {
          "placements": {
            "items": {
              "$ref": "#/components/schemas/Placement"
            },
            "type": "array",
            "title": "Placements"
          },
          "used_count": {
            "type": "integer",
            "title": "Used Count"
          },
          "total_lift": {
            "type": "integer",
            "title": "Total Lift"
          },
          "column_moment": {
            "type": "integer",
            "title": "Column Moment"
          },
          "row_moment": {
            "type": "integer",
            "title": "Row Moment"
          }
        },
        "type": "object",
        "required": [
          "placements",
          "used_count",
          "total_lift",
          "column_moment",
          "row_moment"
        ],
        "title": "BalloonSolution"
      },
      "BalloonSolveResult": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "solved",
              "unsatisfiable",
              "timeout"
            ],
            "title": "Outcome"
          },
          "rule_version": {
            "type": "string",
            "const": "center-torque-v1",
            "title": "Rule Version",
            "default": "center-torque-v1"
          },
          "solution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BalloonSolution"
              },
              {
                "type": "null"
              }
            ]
          },
          "limit_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "time",
                  "work"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit Reason"
          }
        },
        "type": "object",
        "required": [
          "outcome"
        ],
        "title": "BalloonSolveResult"
      },
      "BalloonSolveTaskView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "cancellation_requested": {
            "type": "boolean",
            "title": "Cancellation Requested",
            "default": false
          },
          "computation_stopped": {
            "type": "boolean",
            "title": "Computation Stopped",
            "default": false
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BalloonSolveResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at"
        ],
        "title": "BalloonSolveTaskView"
      },
      "CatalogCandidate": {
        "properties": {
          "fingerprint": {
            "type": "string",
            "title": "Fingerprint"
          },
          "puzzle": {
            "$ref": "#/components/schemas/BalloonPuzzle"
          },
          "target_total_lift": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Total Lift"
          },
          "observations": {
            "type": "integer",
            "title": "Observations",
            "default": 1
          },
          "first_seen": {
            "type": "string",
            "format": "date-time",
            "title": "First Seen"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time",
            "title": "Last Seen"
          }
        },
        "type": "object",
        "required": [
          "fingerprint",
          "puzzle",
          "first_seen",
          "last_seen"
        ],
        "title": "CatalogCandidate"
      },
      "CatalogEntry": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "status": {
            "type": "string",
            "enum": [
              "provisional",
              "verified",
              "disputed"
            ],
            "title": "Status"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CatalogCandidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "code",
          "status",
          "updated_at"
        ],
        "title": "CatalogEntry"
      },
      "CatalogMatch": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available",
            "default": true
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "code_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code Confidence"
          },
          "complete": {
            "type": "boolean",
            "title": "Complete",
            "default": false
          },
          "recorded": {
            "type": "boolean",
            "title": "Recorded",
            "default": false
          },
          "duplicate": {
            "type": "boolean",
            "title": "Duplicate",
            "default": false
          },
          "matched_fingerprint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched Fingerprint"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "provisional",
                  "verified",
                  "disputed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CatalogCandidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "CatalogMatch",
        "description": "How the current recognition relates to the stored catalog."
      },
      "Cell": {
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Row"
          },
          "column": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Column"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "row",
          "column"
        ],
        "title": "Cell"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
