{
  "name": "endfield-puzzle-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host localhost",
    "dev:design": "vite --config vite.design.config.ts --host 127.0.0.1",
    "build:design": "tsc -p tsconfig.design.json && vite build --config vite.design.config.ts",
    "test:calculator": "node --test tests/calculator.test.mjs",
    "test:i18n": "node --test tests/i18n.test.mjs",
    "generate:api": "openapi-typescript ../contracts/openapi.json -o src/generated/api.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "i18next": "^26.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
